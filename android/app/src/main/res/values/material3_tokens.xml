<?xml version="1.0" encoding="utf-8"?>
<!--
  SP-58: Material 3 theme tokens — the NATIVE single source of truth for
  the "Material 3" UI theme on Android.

  Values are extracted 1:1 from PixelMusic (github.com/ianshulyadav/
  PixelMusic) ui/theme/Color.kt + Theme.kt. Material3Tokens.kt serves
  them to Flutter over the zen/material3_tokens channel; the Dart side
  (lib/desktop/material3/m3_palette.dart) carries identical fallbacks so
  Windows renders the same theme without the channel.

  Edit a colour here + Gradle rebuild → the whole Material 3 theme
  re-skins on Android without touching Dart.
-->
<resources>
    <!-- PixelMusic dark scheme anchors -->
    <color name="m3_dark_primary">#FFAB47BC</color>
    <color name="m3_dark_secondary">#FFF06292</color>
    <color name="m3_dark_tertiary">#FFFF8A65</color>
    <color name="m3_dark_background">#FF1E1234</color>
