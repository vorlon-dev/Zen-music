# ════════════════════════════════════════════════════════════════════
# ZenMusic ProGuard / R8 Rules
# ════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# 1. R8 Missing Class Fixes (from build errors)
# ─────────────────────────────────────────────

# Flutter InAppWebView
-keep class com.pichillilorenzo.flutter_inappwebview_android.** { *; }
-dontwarn com.pichillilorenzo.flutter_inappwebview_android.**

# Rhino JS Engine (used by flutter_js / inappwebview)
-dontwarn java.beans.**
-dontwarn org.mozilla.javascript.**

# OkHttp 5 internal missing class
-dontwarn okhttp3.internal.Util

# ─────────────────────────────────────────────
# 2. Native Audio & DSP Engine
# ─────────────────────────────────────────────

# Prevent R8 from stripping native C++ methods (JNI bindings)
-keepclasseswithmembernames class * {
    native <methods>;
}

# Keep your custom native DSP and Innertube bridges
-keep class com.zen.music.zenmusic.** { *; }

# ─────────────────────────────────────────────
# 3. FFmpeg Kit (yt_downloader)
# ─────────────────────────────────────────────

-keep class com.arthemica.ffmpegkit.** { *; }
-keep class com.antonkarpenko.ffmpegkit.FFmpegKitConfig {
    native <methods>;
    void log(long, int, byte[]);
    void statistics(long, int, float, float, long, double, double, double);
    int safOpen(int);
    int safClose(int);
}
-keep class com.antonkarpenko.ffmpegkit.AbiDetect {
    native <methods>;
}
# Standard FFmpegKit package (just in case)
-keep class com.arthenica.ffmpegkit.** { *; }

# ─────────────────────────────────────────────
# 4. Audio Playback (Just Audio & Audio Service)
# ─────────────────────────────────────────────

-keep class com.ryanheise.just_audio.** { *; }
-keep class com.ryanheise.audioservice.** { *; }
-keep class com.ryanheise.audio_session.** { *; }

# ─────────────────────────────────────────────
# 5. Kotlin Serialization (Innertube)
# ─────────────────────────────────────────────

# Keep serializers generated by kotlinx-serialization
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt
-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.zen.music.zenmusic.**$$serializer { *; }
-keepclassmembers class com.zen.music.zenmusic.** {
    *** Companion;
}
-keepclasseswithmembers class com.zen.music.zenmusic.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# ─────────────────────────────────────────────
# 6. Ktor / OkHttp Networking
# ─────────────────────────────────────────────

-dontwarn org.slf4j.**
-dontwarn io.ktor.**
-keep class io.ktor.** { *; }

# ─────────────────────────────────────────────
# 7. Standard Flutter Rules
# ─────────────────────────────────────────────

-keep class io.flutter.app.** { *; }
-keep class io.flutter.plugin.**  { *; }
-keep class io.flutter.util.**  { *; }
-keep class io.flutter.view.**  { *; }
-keep class io.flutter.**  { *; }
-keep class io.flutter.plugins.**  { *; }

# Keep generic signatures for reflection
-keepattributes Signature
-keepattributes *Annotation*